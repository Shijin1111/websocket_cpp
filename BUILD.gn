declare_args() {
  is_debug = true
  # CHANGE THESE PATHS to match your installation
  boost_root = "C:/boost/boost_1_90_0"
  openssl_root = "C:/Program Files/OpenSSL-Win64"
}

config("external_libs") {
  include_dirs = [
    "$boost_root",
    "$openssl_root/include",
  ]
  ldflags = [
    "/LIBPATH:$openssl_root/lib/VC/x64/MDd",
    "/LIBPATH:$boost_root/lib64-msvc-14.3",
    "libssl.lib",
    "libcrypto.lib",
    "crypt32.lib",
    "ws2_32.lib",
    "wldap32.lib",
  ]
}

# NEW: shared config to add /bigobj for MSVC
config("msvc_bigobj") {
  cflags = [ "/bigobj" ]  # applies to both C and C++
  # (You could also use cflags_cc = [ "/bigobj" ], but cflags is enough)
}

executable("ws_client") {
  sources = [
    "src/main.cc",
    "src/client/ws_client.cc",
    "src/client/ws_client.h",
    "src/cli/user_interface.cc",
    "src/cli/user_interface.h",
  ]

  configs += [
    ":external_libs",
    ":msvc_bigobj",   # <-- add here
  ]

  if (is_debug) {
    configs += [ "//build:debug" ]
  } else {
    configs += [ "//build:release" ]
  }
}

executable("unit_tests") {
  sources = [
    "tests/unit_tests.cc",
    "src/client/ws_client.cc",
    "src/client/ws_client.h",
  ]

  configs += [
    ":external_libs",
    ":msvc_bigobj",   # <-- and here
  ]

  # Simple definition for testing
  defines = [ "TEST_MODE" ]
}
