config("compiler_defaults") {
  if (host_os == "win") {
    # --- MSVC (Windows) Flags ---
    cflags = [
      "/EHsc",          # Catch C++ exceptions
      "/std:c++17",     # Use C++17
      "/W3",            # Warning level 3
      "/DWIN32_LEAN_AND_MEAN",
      "/DNOMINMAX",
      "/D_WIN32_WINNT=0x0601",
    ]
  } else {
    # --- GCC / Clang (Linux/Mac) Flags ---
    cflags = [
      "-std=c++17",
      "-Wall",
      "-pthread",       # Required for Boost threading on Linux
    ]
  }
}

config("debug") {
  if (host_os == "win") {
    cflags = [ "/Zi", "/Od" ]
    ldflags = [ "/DEBUG" ]
  } else {
    cflags = [ "-g", "-O0" ]
  }
}

config("release") {
  if (host_os == "win") {
    cflags = [ "/O2", "/DNDEBUG" ]
    ldflags = [ "/OPT:REF", "/OPT:ICF" ]
  } else {
    cflags = [ "-O3", "-DNDEBUG" ]
  }
}