toolchain("msvc") {
  tool("cc") {
    command = "cl.exe /nologo /FC /c {{source}} /Fo{{output}} {{cflags}} {{defines}} {{include_dirs}}"
    outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.obj" ]
    description = "CC {{output}}"
  }
  tool("cxx") {
    command = "cl.exe /nologo /FC /c {{source}} /Fo{{output}} {{cflags}} {{defines}} {{include_dirs}}"
    outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.obj" ]
    description = "CXX {{output}}"
  }
  tool("alink") {
    command = "lib.exe /nologo {{arflags}} /OUT:{{output}} {{inputs}}"
    outputs = [ "{{target_out_dir}}/{{target_output_name}}.lib" ]
    description = "LIB {{output}}"
  }
  tool("link") {
    command = "link.exe /nologo {{ldflags}} /OUT:{{output}} {{inputs}} {{solibs}} {{libs}}"
    outputs = [ "{{root_out_dir}}/{{target_output_name}}{{output_extension}}" ]
    description = "LINK {{output}}"
    default_output_extension = ".exe"
  }
  tool("stamp") {
    command = "cmd /c type nul > {{output}}"
    description = "STAMP {{output}}"
  }
  tool("copy") {
    command = "cmd /c copy /y {{source}} {{output}}"
    description = "COPY {{source}} {{output}}"
  }
}

toolchain("gcc") {
  tool("cc") {
    command = "gcc -MMD -MF {{output}}.d {{cflags}} {{defines}} {{include_dirs}} -c {{source}} -o {{output}}"
    depfile = "{{output}}.d"
    outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
    description = "CC {{output}}"
  }
  tool("cxx") {
    command = "g++ -MMD -MF {{output}}.d {{cflags}} {{defines}} {{include_dirs}} -c {{source}} -o {{output}}"
    depfile = "{{output}}.d"
    outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
    description = "CXX {{output}}"
  }
  tool("alink") {
    command = "ar rcs {{output}} {{inputs}}"
    outputs = [ "{{target_out_dir}}/{{target_output_name}}.a" ]
    description = "AR {{output}}"
  }
  tool("link") {
    command = "g++ {{ldflags}} -o {{output}} {{inputs}} {{libs}}"
    outputs = [ "{{root_out_dir}}/{{target_output_name}}{{output_extension}}" ]
    description = "LINK {{output}}"
    default_output_extension = ""
  }
  tool("stamp") {
    command = "touch {{output}}"
    description = "STAMP {{output}}"
  }
  tool("copy") {
    command = "cp -af {{source}} {{output}}"
    description = "COPY {{source}} {{output}}"
  }
}